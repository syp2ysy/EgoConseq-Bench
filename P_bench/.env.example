# Copy this file to .env.local, edit the paths, then run:
#   source .env.local

export P_BENCH_ROOT=/absolute/path/to/EgoConseq-Bench/P_bench
export EGOCONSEQ_DATA_ROOT="$P_BENCH_ROOT/data/sources"
export EGOCONSEQ_HABITAT_PYTHON=/path/to/miniconda3/envs/egoconseq-habitat/bin/python
export EGOCONSEQ_B1K_PYTHON=/path/to/miniconda3/envs/behavior/bin/python

# R2R / Matterport3D
export EGOCONSEQ_R2R_TRAIN_EPISODES="$EGOCONSEQ_DATA_ROOT/r2r_vlnce_v1-3/train/train.json.gz"
export EGOCONSEQ_MP3D_ROOT="$EGOCONSEQ_DATA_ROOT/scene_datasets/mp3d"

# Habitat-GS / InteriorGS
export EGOCONSEQ_GS_ROOT="$EGOCONSEQ_DATA_ROOT/gs"
export EGOCONSEQ_GS_TRAIN_MANIFEST="$EGOCONSEQ_GS_ROOT/splits/train.json"
export SAGE3D_COLLISION_ROOT="$EGOCONSEQ_DATA_ROOT/SAGE-3D_Collision_Mesh"

# BEHAVIOR-1K
export B1K_DATA_ROOT="$EGOCONSEQ_DATA_ROOT/behavior-1k-v3.9.1"
export B1K_SOURCE_MANIFEST="$P_BENCH_ROOT/data/b1k-authority/audit-derived-source-manifest.json"
export B1K_CATALOG_AUDIT="$P_BENCH_ROOT/data/b1k-authority/catalog-authority-audit.json"

# Generated runs stay below the repository by default.
export EGOCONSEQ_RUN_ROOT="$P_BENCH_ROOT/data/candidate_pool"

# Inference/evaluation runtimes: set each path to your own installed environment.
export INFER_PYTHON=/path/to/miniconda3/envs/qwen3vl/bin/python
export EVAL_PYTHON="$INFER_PYTHON"
export QWEN_PYTHON="$INFER_PYTHON"
export MODERN_PYTHON=/path/to/miniconda3/envs/vllm_serve/bin/python
export COSMOS_PYTHON=/path/to/cosmos3-runtime/bin/python
export SFT_PYTHON="$INFER_PYTHON"
